{
  // Cloudflare Worker configuration for FindMeAPlayground.
  // Deploys src/worker.js as the Worker entry point alongside the pre-built
  // Vite static assets in dist/. The Worker routes /api/travel-times to the
  // ORS proxy and serves assets for everything else.
  "name": "find-me-a-playground",
  "compatibility_date": "2024-01-01",

  // Worker entry point — handles API routing and falls back to ASSETS.
  "main": "src/worker.js",

  // Static assets served directly from the CDN for all non-API routes.
  "assets": {
    "directory": "./dist"
  }
}
